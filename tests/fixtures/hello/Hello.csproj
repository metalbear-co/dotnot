<!--
  The smallest .NET app: its build makes an apphost and an IL .dll, and its single-file
  publish makes a bundle. The tests copy it to target/tmp and build it there, offline.
  The target framework follows the installed SDK, whose own packs are all a build needs.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <!--
      A single-file publish turns this analyzer on. It needs the ILLink pack, which also pulls
      in the runtime packs, and none of those ship with the SDK: an offline restore fails on
      any machine whose NuGet cache doesn't already hold them. The bundle holds the same files.
    -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>
</Project>
